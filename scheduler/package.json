{
  "name": "ctr-social-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Social media scheduler for Conversations to Remember: post queue, projected schedule, Google Calendar sync.",
  "workspaces": ["server", "client"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace client",
    "start": "npm start --workspace server",
    "test": "npm test --workspace server",
    "db:seed": "npm run seed --workspace server",
    "share": "node scripts/share.mjs"
  }
}
